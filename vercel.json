{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'" },
        { "key": "Access-Control-Allow-Origin", "value": "https://rppromo-caixinhas.com.br" }
      ]
    }
  ],
  "redirects": [
    { "source": "/whatsapp", "has": [{ "type": "query", "key": "text", "value": "(?<text>.*)" }], "destination": "https://wa.me/5500000000000?text=:text", "permanent": false },
    { "source": "/whatsapp", "destination": "https://wa.me/5500000000000", "permanent": false },
    { "source": "/:path(.*)", "has": [{ "type": "host", "value": "www.rppromo-caixinhas.com.br" }], "destination": "https://rppromo-caixinhas.com.br/:path", "permanent": true }
  ]
}
